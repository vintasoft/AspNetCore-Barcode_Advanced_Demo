<script src="@Url.Content("~/js/UI/Dialogs/Barcode/Gs1ValueEditorDialog.js")" type="text/javascript"></script>
<div class="modal" id="gs1ValueEditorDialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="gs1ValueEditorDialogTitle"><label localizationId="gs1ValueEditorDialog_gs1ValueEditorDialogTitle">GS1 Value Editor</label></h5>
            </div>
            <div class="modal-body">
                <label localizationId="gs1ValueEditorDialog_gs1PrintableValue" for="gs1PrintableValue">GS1 printable value:</label>
                <br />
                <input type="text" id="gs1PrintableValue" style="width: 550px;" tabindex="-1" value="(01)01234567890128" readonly />
                <br />
                <br />
                <label localizationId="gs1ValueEditorDialog_gs1Value" for="gs1Value">GS1 value (set of GS1 Application Identifier values):</label>
                <br />
                <table id="gs1Value" border="1" style="width: 550px;">
                    <tr>
                        <th><label localizationId="gs1ValueEditorDialog_gs1ValuesTable_ai">AI</label></th>
                        <th><label localizationId="gs1ValueEditorDialog_gs1ValuesTable_aiName">AI name</label></th>
                        <th><label localizationId="gs1ValueEditorDialog_gs1ValuesTable_aiData">AI data</label></th>
                        <th><label localizationId="gs1ValueEditorDialog_gs1ValuesTable_actions">Actions</label></th>
                    </tr>
                    <tr>
                        <td>01</td>
                        <td>GTIN</td>
                        <td>01234567890128</td>
                        <td style="text-align: center;"><button type="button" id="editGs1AppIdValue" localizationId="gs1ValueEditorDialog_editGs1AppIdValue">Edit</button> <button type="button" id="deleteGs1AppIdValue" localizationId="gs1ValueEditorDialog_deleteGs1AppIdValue">Delete</button></td>
                    </tr>
                </table>
                <br />
                <input localizationId="gs1ValueEditorDialog_addGs1AppIdValue" type="button" value="Add GS1 Application Identifier value to GS1 value" id="addGs1AppIdValue" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="javascript: Gs1ValueEditorDialogJS.__gs1ValueEditorDialog_copyValueToClipboadButton_clicked(); return false;" localizationId="gs1ValueEditorDialog_copyValueToClipboadButton">Copy GS1 printable value to the clipboard</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" localizationId="gs1ValueEditorDialog_closeButton">Close</button>
            </div>
        </div>
    </div>
</div>